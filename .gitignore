node_modules/
dist/
*.log

# Local demo sandboxes and generated chain state
midnight-level-db/

# A compiled contract build an operator drops at the root for
# `examples/passport-funder` to auto-discover (FUNDER_ACCOUNT_ASSETS and
# FUNDER_MIDNAMES_ASSETS are the supported way to name one). Machine output,
# and ~100 MB of prover keys; never committed.
/contracts/managed/

# Generated ZK assets and staged contract builds.
#
# Both of the first two are staged by
# examples/passport-demo/scripts/prepare-zk-assets.mjs from the stagenet
# contract build. The compiled contract modules live inside the workspace so
# they resolve the ledger-9 compact-runtime; they are generated output either
# way and are never committed.
examples/passport-demo/.generated/
examples/passport-demo/public/zk/
examples/passport-demo/contracts/stagenet/
# The stagenet contract build itself: ~103 MB of prover and verifier keys,
# produced by the deployment harness and shared with the demo through the
# staging script above. The contract/ and compiler/ halves beside these two
# ARE tracked — see .github/workflows/deploy-demo.yml.
examples/passport-balancer/contracts-stagenet/managed/*/keys/
examples/passport-balancer/contracts-stagenet/managed/*/zkir/
# Prover keys that never reach a browser. sync-account-custody-contract.mjs
# parks the account custody build's 3.2 GB here rather than in keys/, so that
# `keys/` is what it is everywhere else — the verifier keys a browser fetches.
# This directory is what an operator copies to the proving server.
examples/passport-balancer/contracts-stagenet/managed/*/prover-keys/
# The account custody contract, downloaded rather than kept. It is Nicolas's
# and no copy of it lives in this repository: scripts/sync-account-custody-contract.mjs
# fetches it from the commit pinned in scripts/account-custody-contract.lock.json,
# checks its sha256, and compiles it into managed/account-custody. Only the
# compiler output of that unchanged source is tracked.
examples/passport-balancer/contracts-stagenet/upstream/

# Vercel CLI link state and the locally assembled Build Output (see
# scripts/build-vercel-output.mjs). Never committed — the deployed artefacts
# are produced locally or in CI and uploaded with `vercel deploy --prebuilt`.
.vercel/

# Node
npm-debug.log
yarn-error.log
.npm/

# Editor / IDE
.vscode/
.idea/
*.swp
*.swo
.DS_Store

# Environment / secrets
.env
.env.local
*.key
*.pem

# Coverage / test output
coverage/
*.lcov
playwright-report/
test-results/

# The `*.log` rule at the top would otherwise swallow one deliberately
# committed log: the stagenet shielded-receipt drill transcript, which is
# evidence rather than output. Re-admit just that file.
!examples/passport-balancer/deploy-stagenet/shielded-receipt-drill.log
