# Credentials stay server-side. Passport sign-in is required by default.
# Optional operator token (at least 32 characters in production) grants access
# to legacy/shared projects AFTER Passport sign-in.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-6-luna-pro:nitro
OPENROUTER_IMAGE_MODEL=meta/muse-image
OPENROUTER_MODELS=openai/gpt-6-luna-pro:nitro
BUILDER_ACCESS_TOKEN=
# Explicit local-only sign-in bypass. Production refuses true.
BUILDER_DEV_MODE=false
BUILDER_DATA_DIR=./data
PORT=5189
# Sign-in and approvals share this origin and its existing account/passkey.
PASSPORT_ORIGIN=https://midnightpassport.com
# Optional override; production requires it to match PASSPORT_ORIGIN.
# For a local Passport, use http://localhost:5175 for both.
# PASSPORT_AUTH_ORIGIN=https://midnightpassport.com
# All service endpoints below are stage-net. Never use preview/preprod fallbacks.
BUILDER_INDEXER_URL=https://indexer.stagenet.shielded.tools/api/v4/graphql
BUILDER_NODE_URL=wss://rpc.stagenet.shielded.tools
BUILDER_PROOF_SERVER_URL=https://67-205-177-162.sslip.io/prover
BUILDER_SPONSOR_URL=https://67-205-177-162.sslip.io/balancer
# Trusted production origins for sign-in callbacks and iframe communication.
# Each request uses its own trusted origin; no redirect is required during DNS setup.
# BUILDER_PUBLIC_URL=https://your-builder.up.railway.app
# BUILDER_ALLOWED_ORIGINS=https://builder.midnightpassport.com
# Optional compact manager executable; pinned compiler remains 0.34.0.
# BUILDER_COMPACT_BIN=compact

# Durable allowances count generation attempts, including interrupted builds.
BUILDER_USER_BUILDS_PER_DAY=20
BUILDER_TOTAL_BUILDS_PER_DAY=200
