# The exact origin of the Passport you are testing against: scheme, host, and
# port, no trailing path. A wrong value fails silently (messages are dropped).
#   https://midnightpassport.com              production
#   https://midnight-passport-dev.vercel.app  internal development build
#   http://localhost:5175                     Passport run from the repository
VITE_PASSPORT_ORIGIN=https://midnightpassport.com
